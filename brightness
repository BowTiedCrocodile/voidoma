#!/usr/bin/env python3
"""Adjust the internal display through elogind, without direct sysfs writes."""
import argparse
from pathlib import Path
import subprocess
import sys

parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument('direction', choices=('up', 'down'))
parser.add_argument('--device', help='backlight device name; defaults to the first available')
parser.add_argument('--dry-run', action='store_true')
args = parser.parse_args()
root = Path('/sys/class/backlight')
devices = sorted(root.iterdir())
if args.device:
    devices = [p for p in devices if p.name == args.device]
if not devices:
    parser.error('No matching backlight device; external monitors may need DDC controls.')
device = devices[0]
try:
    current = int((device / 'brightness').read_text())
    maximum = int((device / 'max_brightness').read_text())
    step = max(1, round(maximum * 0.05))
    target = max(1, min(maximum, current + (step if args.direction == 'up' else -step)))
    if not args.dry_run:
        subprocess.run(['busctl', '--system', 'call', 'org.freedesktop.login1',
                        '/org/freedesktop/login1/session/auto',
                        'org.freedesktop.login1.Session', 'SetBrightness',
                        'ssu', 'backlight', device.name, str(target)], check=True, timeout=5)
    print(f'{device.name}: {current} -> {target} / {maximum}')
except (OSError, ValueError, subprocess.SubprocessError) as exc:
    print(f'Brightness adjustment failed: {exc}', file=sys.stderr)
    sys.exit(1)
